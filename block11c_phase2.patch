+++ b/apps/reality_painter/assets/sources_config.py
@@ -0,0 +1,99 @@
+"""Configured external GitHub asset-source repositories for Reality Painter.
+
+Defines the small, verified set of public GitHub repositories the
+automatic asset registry discovers 3D assets from (Block 11C Phase 2).
+This module performs no network access itself and never touches
+`apps.reality_painter.assets.github`'s discovery logic - it only
+describes *where* discovery should look. Order matters: it is both the
+scan order and, by extension, the resolution priority a caller sees
+from `apps.reality_painter.inspection.asset_resolver`.
+
+Configurable without a code change via the `REALITY_PAINTER_ASSET_REPOS`
+environment variable: a comma-separated list of `"owner/repo"` or
+`"owner/repo:path"` entries, evaluated in the given order. An unset or
+empty variable falls back to `DEFAULT_ASSET_REPOSITORIES`.
+
+Repositories are added here only after being manually verified:
+    - `KhronosGroup/glTF-Sample-Assets`: the official Khronos glTF
+      sample-asset collection. Public, actively maintained, and
+      confirmed reachable via the GitHub API (HTTP 200, not private).
+      Contains many named `.glb` models under `Models/`, and is
+      already the source of the ABeautifulGame asset already present
+      in this project's local asset cache
+      (`apps/reality_painter/assets/cache/`) - the existing GitHub
+      discovery code (`github.py`) is already proven against this
+      repository. No repository-level SPDX license id is exposed via
+      the GitHub API for this repo (`license: None`); per-model
+      licensing is documented inside each model's own directory.
+      `Asset.license` is purely informational and never enforced (see
+      `schema.py`), so this is recorded as `None`/unknown rather than
+      guessed.
+
+No other repository is added without meeting the same bar: public,
+reachable, containing real `.glb`/`.gltf` files under a conventional
+directory layout, and compatible for this project's use. Adding a
+future source is a config-only change - either editing
+`DEFAULT_ASSET_REPOSITORIES` below or setting the environment
+variable - never a change to discovery/registration logic itself.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import List, Tuple
+
+_ENV_VAR = "REALITY_PAINTER_ASSET_REPOS"
+
+
+@dataclass(frozen=True)
+class AssetRepositoryConfig:
+    """One configured discovery source.
+
+    Attributes:
+        repository: `"owner/name"` of a public GitHub repository.
+        path: Directory (or single file) within the repository to
+            scope discovery to. Empty string means the whole
+            repository.
+    """
+
+    repository: str
+    path: str = ""
+
+
+#: The verified default set, used whenever `REALITY_PAINTER_ASSET_REPOS`
+#: is unset - see module docstring for why each entry was added.
+DEFAULT_ASSET_REPOSITORIES: Tuple[AssetRepositoryConfig, ...] = (
+    AssetRepositoryConfig(repository="KhronosGroup/glTF-Sample-Assets", path="Models"),
+)
+
+
+def get_configured_repositories() -> List[AssetRepositoryConfig]:
+    """Returns the ordered list of repositories discovery should scan.
+
+    Reads `REALITY_PAINTER_ASSET_REPOS` if set and non-empty; falls
+    back to `DEFAULT_ASSET_REPOSITORIES` otherwise. Malformed entries
+    (missing `owner/repo` shape) are validated later, by
+    `github.discover_assets`'s own repository parsing - this function
+    performs no validation of its own, only splitting.
+
+    Returns:
+        Repositories in scan order. Never empty (falls back to the
+        default set if the environment variable parses to nothing
+        usable).
+    """
+    raw = os.getenv(_ENV_VAR)
+    if not raw or not raw.strip():
+        return list(DEFAULT_ASSET_REPOSITORIES)
+
+    configs: List[AssetRepositoryConfig] = []
+    for entry in raw.split(","):
+        entry = entry.strip()
+        if not entry:
+            continue
+        repository, separator, path = entry.partition(":")
+        configs.append(
+            AssetRepositoryConfig(repository=repository.strip(), path=path.strip() if separator else "")
+        )
+
+    return configs or list(DEFAULT_ASSET_REPOSITORIES)
