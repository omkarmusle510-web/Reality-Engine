@@ -183,6 +185,78 @@ def ingest_repository(
     return added, skipped
 
 
+@dataclass(frozen=True)
+class RepositoryIngestResult:
+    """The outcome of ingesting one configured repository.
+
+    Attributes:
+        repository: The `"owner/name"` that was attempted.
+        succeeded: Whether discovery/ingestion completed without error.
+        added: Newly registered asset count (0 if `succeeded` is False).
+        skipped: Already-registered asset count (0 if `succeeded` is
+            False).
+        error: A human-readable failure reason, or `None` on success.
+    """
+
+    repository: str
+    succeeded: bool
+    added: int
+    skipped: int
+    error: Optional[str] = None
+
+
+def ingest_configured_repositories(
+    registry: AssetRegistry,
+    repositories: Optional[Sequence[AssetRepositoryConfig]] = None,
+    session: Optional[Any] = None,
+) -> List[RepositoryIngestResult]:
+    """Ingests every configured repository into `registry`, isolating failures.
+
+    Repositories are scanned in order (see
+    `apps.reality_painter.assets.sources_config`) via the existing
+    `ingest_repository`. A repository that is unreachable, rate-limited,
+    private, or otherwise fails never stops the remaining repositories
+    from being attempted - Reality Painter must keep running even if
+    every configured source is temporarily unavailable. Re-running this
+    against the same repositories never creates duplicate registry
+    entries, since `ingest_repository` already relies on
+    `AssetRegistry.register()`'s idempotent id-based skip.
+
+    Args:
+        registry: The `AssetRegistry` to ingest discovered assets into.
+        repositories: Repositories to scan, in order. Defaults to
+            `get_configured_repositories()`.
+        session: See `discover_assets`.
+
+    Returns:
+        One `RepositoryIngestResult` per repository, in the same order.
+        Never raises.
+    """
+    active_repositories = repositories if repositories is not None else get_configured_repositories()
+    results: List[RepositoryIngestResult] = []
+
+    for config in active_repositories:
+        try:
+            added, skipped = ingest_repository(
+                registry, config.repository, path=config.path, session=session
+            )
+            results.append(
+                RepositoryIngestResult(repository=config.repository, succeeded=True, added=added, skipped=skipped)
+            )
+        except GitHubSourceError as exc:
+            logger.warning("Asset discovery failed for repository '%s': %s", config.repository, exc)
+            results.append(
+                RepositoryIngestResult(repository=config.repository, succeeded=False, added=0, skipped=0, error=str(exc))
+            )
+        except Exception as exc:  # defensive: one bad repo must never crash discovery
+            logger.exception("Unexpected error discovering repository '%s'.", config.repository)
+            results.append(
+                RepositoryIngestResult(repository=config.repository, succeeded=False, added=0, skipped=0, error=str(exc))
+            )
+
+    return results
+
+
 # --- Repository / path parsing -----------------------------------------
 
 
