diff --git a/tests/test_multi_repo_discovery.py b/tests/test_multi_repo_discovery.py
new file mode 100644
index 0000000..6c52134
--- /dev/null
+++ b/tests/test_multi_repo_discovery.py
@@ -0,0 +1,137 @@
+"""Offline, deterministic tests for Block 11C Phase 2 multi-repository discovery.
+
+No network access - every GitHub HTTP response is mocked, matching the
+existing convention in tests/test_github_asset_source.py. Proves:
+    1. Multiple configured repositories are scanned.
+    2. One failing repository does not stop another.
+    3. Duplicate assets are not registered repeatedly (repeat scan is a no-op).
+    4. Discovered assets persist in the registry (subsequent search finds them).
+    5. Once an asset is in the registry, resolve_asset never re-triggers discovery.
+"""
+import os
+
+from apps.reality_painter.assets.github import ingest_configured_repositories
+from apps.reality_painter.assets.registry import AssetRegistry
+from apps.reality_painter.assets.sources_config import AssetRepositoryConfig
+from apps.reality_painter.inspection.asset_resolver import AssetResolutionStatus, resolve_asset
+
+passed = 0
+failed = 0
+
+
+def check(name, condition):
+    global passed, failed
+    if condition:
+        passed += 1
+        print(f"PASS: {name}")
+    else:
+        failed += 1
+        print(f"FAIL: {name}")
+
+
+class FakeResponse:
+    def __init__(self, status_code, json_data=None, headers=None):
+        self.status_code = status_code
+        self._json_data = json_data
+        self.headers = headers or {}
+
+    def json(self):
+        return self._json_data
+
+
+class FakeSession:
+    """Maps exact URLs to canned responses; unmapped URLs raise a connection error."""
+
+    def __init__(self, routes):
+        self._routes = routes
+        self.requested_urls = []
+
+    def get(self, url, params=None, headers=None, timeout=None):
+        self.requested_urls.append(url)
+        route = self._routes.get(url)
+        if route is None:
+            import requests
+
+            raise requests.exceptions.ConnectionError(f"Unreachable in test: {url}")
+        if isinstance(route, Exception):
+            raise route
+        return route
+
+
+GOOD_REPO_URL = "https://api.github.com/repos/good/repo"
+GOOD_TREE_URL = "https://api.github.com/repos/good/repo/git/trees/main"
+BAD_REPO_URL = "https://api.github.com/repos/bad/repo"
+
+good_routes = {
+    GOOD_REPO_URL: FakeResponse(200, {"default_branch": "main", "license": {"spdx_id": "CC0-1.0"}}),
+    GOOD_TREE_URL: FakeResponse(
+        200,
+        {
+            "tree": [
+                {"path": "nature/tree.glb", "type": "blob"},
+                {"path": "nature/sun.glb", "type": "blob"},
+            ]
+        },
+    ),
+    # "bad/repo" is deliberately absent -> ConnectionError, isolating the failure.
+}
+
+repos = [
+    AssetRepositoryConfig(repository="bad/repo"),
+    AssetRepositoryConfig(repository="good/repo"),
+]
+
+# --- 1 & 2: multiple repos scanned; one failure doesn't stop another --------
+registry = AssetRegistry()
+results = ingest_configured_repositories(registry, repositories=repos, session=FakeSession(good_routes))
+
+check("both configured repositories were attempted", len(results) == 2)
+check("bad/repo failed and was isolated", results[0].repository == "bad/repo" and not results[0].succeeded)
+check("good/repo succeeded despite bad/repo failing first", results[1].repository == "good/repo" and results[1].succeeded)
+check("good/repo added 2 new assets", results[1].added == 2)
+check("registry now has 2 assets", len(registry) == 2)
+
+# --- 3: duplicate assets are not registered repeatedly ----------------------
+results_again = ingest_configured_repositories(registry, repositories=repos, session=FakeSession(good_routes))
+good_result_again = results_again[1]
+check("re-scanning good/repo adds nothing new", good_result_again.added == 0)
+check("re-scanning good/repo reports both as skipped", good_result_again.skipped == 2)
+check("registry size unchanged after re-scan", len(registry) == 2)
+
+# --- 4: discovered assets persist in the registry (searchable) -------------
+tree_matches = registry.search_assets("tree")
+check("discovered 'tree' asset is searchable", len(tree_matches) == 1 and tree_matches[0].id.endswith("tree_glb"))
+
+# --- 5: resolve_asset only triggers discovery on a miss ---------------------
+# resolve_asset() has no `repositories` param - it always goes through
+# get_configured_repositories(), so the env var is set here to point at
+# the same fake repos used above, and restored afterward.
+_previous_env = os.environ.get("REALITY_PAINTER_ASSET_REPOS")
+os.environ["REALITY_PAINTER_ASSET_REPOS"] = "bad/repo,good/repo"
+
+fresh_registry = AssetRegistry()
+session = FakeSession(good_routes)
+resolution = resolve_asset("sun", fresh_registry, session=session)
+check("resolve_asset discovers and resolves 'sun' on first miss", resolution.status == AssetResolutionStatus.RESOLVED)
+check("resolve_asset ran discovery against configured repos", any("good/repo" in url or "bad/repo" in url for url in session.requested_urls))
+
+requests_before = len(session.requested_urls)
+resolution_again = resolve_asset("sun", fresh_registry, session=session)
+check("resolve_asset resolves 'sun' again without error", resolution_again.status == AssetResolutionStatus.RESOLVED)
+check(
+    "second resolve_asset call for an already-registered label makes no new HTTP requests",
+    len(session.requested_urls) == requests_before,
+)
+
+# --- unresolvable label still cleanly reports UNAVAILABLE -------------------
+missing_resolution = resolve_asset("unicorn", fresh_registry, session=session)
+check("unmatched label after discovery is UNAVAILABLE", missing_resolution.status == AssetResolutionStatus.UNAVAILABLE)
+
+if _previous_env is None:
+    os.environ.pop("REALITY_PAINTER_ASSET_REPOS", None)
+else:
+    os.environ["REALITY_PAINTER_ASSET_REPOS"] = _previous_env
+
+print(f"\n{passed} passed, {failed} failed")
+if failed:
+    raise SystemExit(1)
